# Copy to .env.local. Never commit real keys. All server-side only (no NEXT_PUBLIC_).

# Nemotron agent. Any OpenAI-compatible endpoint with tool calling:
#  - NVIDIA hosted API: https://integrate.api.nvidia.com/v1 (key from build.nvidia.com)
#  - Self-hosted on Brev (vLLM / NIM): http://<brev-host>:8000/v1 (key optional)
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_API_KEY=
# Pick a Nemotron model that supports tool calling; check the model card on build.nvidia.com.
NEMOTRON_MODEL=

NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com
