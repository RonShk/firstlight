# Copy to .env.local. Never commit real keys. All server-side only (no NEXT_PUBLIC_).
# Chat model: our Brev vLLM server (OpenAI-compatible). Defaults to https://integrate.api.nvidia.com/v1 when empty
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=
# Exact model id served at NEMOTRON_BASE_URL (must support tool calling; vLLM: --enable-auto-tool-choice)
NEMOTRON_MODEL=
# Hosted NVIDIA services (build.nvidia.com key): embeddings, reranker and safety guard.
# `npm run knowledge:ingest` embeds the policy documents; the same model embeds search queries.
NEMOTRON_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
NEMOTRON_EMBED_BASE_URL=
NEMOTRON_EMBED_API_KEY=
# Reranker (default nvidia/llama-nemotron-rerank-vl-1b-v2; "off" disables). URL is derived from the model.
NEMOTRON_RERANK_MODEL=
NEMOTRON_RERANK_URL=
# Safety guard (default nvidia/llama-3.1-nemotron-safety-guard-8b-v3; "off" disables)
NEMOTRON_GUARD_MODEL=
# Agent runtime: worker loops per process, "external" to run workers via `npm run agent:worker`,
# AGENT_VERIFIER=off to skip the verifier agent, and per-run budgets.
AGENT_CONCURRENCY=4
AGENT_WORKERS=
AGENT_VERIFIER=
AGENT_MAX_TURNS=14
AGENT_MAX_TOOL_CALLS=24
AGENT_RUN_TIMEOUT_MS=180000
# vLLM: disable hidden reasoning to avoid spending the output budget before tool calls.
NEMOTRON_ENABLE_THINKING=false
# Per-step output cap for Nemotron (includes hidden reasoning)
AGENT_MAX_OUTPUT_TOKENS=8192
# Optional SMS delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com
# Operational SQLite (cases, runs, events, outbox). Knowledge base path: KNOWLEDGE_DB_PATH (default data/knowledge.db)
DATABASE_URL=file:./local.db
