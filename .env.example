# Copy to .env.local. Never commit real keys. All server-side only (no NEXT_PUBLIC_).
# Chat model: our Brev vLLM server (OpenAI-compatible). Defaults to https://integrate.api.nvidia.com/v1 when empty
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=
# Exact model id served at NEMOTRON_BASE_URL; check with `npm run agent:smoke`
NEMOTRON_MODEL=
# Policy RAG embeddings (NVIDIA hosted, build.nvidia.com key). Base URL defaults to the NVIDIA hosted API.
# `npm run agent:index` embeds the policy documents; the same model embeds customer queries.
NEMOTRON_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
NEMOTRON_EMBED_BASE_URL=
NEMOTRON_EMBED_API_KEY=
# Optional reranker; leave empty to skip reranking
NEMOTRON_RERANK_MODEL=
NEMOTRON_RERANK_URL=
# Items above this estimated amount always go to human review
PROVISIONAL_CAP_USD=2500
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com
DATABASE_URL=file:./local.db
